# -----------------------------------------------------------------------
# Learn Anything Backend - Environment Variables
# Copy this file to ".env" and fill in your real values.
# NEVER commit your actual .env file to version control.
# -----------------------------------------------------------------------

# Which LLM provider to use. Currently supported: "openai"
# (Designed to support "claude" / "gemini" in the future without code changes.)
LLM_PROVIDER=openai

# --- OpenAI settings ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Future provider settings (not required unless LLM_PROVIDER is changed) ---
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- General app settings ---
APP_NAME=Learn Anything Backend
ENVIRONMENT=development
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Comma-separated list of allowed CORS origins, or "*" for all (dev only).
# Example: CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGINS=*